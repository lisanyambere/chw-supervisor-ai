# ── OpenMRS ───────────────────────────────────────────────────────────────────
OPENMRS_DB_USER=openmrs
OPENMRS_DB_PASSWORD=openmrs
OPENMRS_DB_ROOT_PASSWORD=openmrs_root
OPENMRS_BASE_URL=http://localhost:8080/openmrs
OPENMRS_FHIR_URL=http://localhost:8080/openmrs/ws/fhir2/R4
OPENMRS_API_USER=admin
OPENMRS_API_PASSWORD=Admin123

# ── Application Database ──────────────────────────────────────────────────────
APP_DB_NAME=community_health
APP_DB_USER=app
APP_DB_PASSWORD=app_secret
DATABASE_URL=postgresql://app:app_secret@localhost:5432/community_health

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_secret@localhost:6379/0
REDIS_AUTH=redis_secret

# ── Langfuse v3 (self-hosted) ─────────────────────────────────────────────────
LANGFUSE_NEXTAUTH_SECRET=changeme_langfuse_nextauth_32chars
LANGFUSE_SALT=changeme_langfuse_salt_32chars__
LANGFUSE_HOST=http://localhost:3100
# Required by v3. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LANGFUSE_ENCRYPTION_KEY=
# Sub-services
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse_secret
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_secret
# Project keys (auto-provisioned via LANGFUSE_INIT_* on first boot of langfuse-web).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── LLM — OpenRouter ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model to use — OpenRouter supports anthropic/claude-3.5-sonnet, openai/gpt-4o, etc.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ── LLM provider switch ───────────────────────────────────────────────────────
# One of: openrouter, azure
LLM_PROVIDER=openrouter

# ── LLM retry (openai SDK handles backoff + Retry-After; we set attempt count)
LLM_MAX_ATTEMPTS=3

# ── LLM — Azure OpenAI (used when LLM_PROVIDER=azure) ─────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Name of the *deployment* (not the underlying model id).
AZURE_OPENAI_DEPLOYMENT=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Java (for Synthea — set to JDK 11+ install dir) ─────────────────────────
# JAVA_HOME=C:\Program Files\Microsoft\jdk-21.0.10.7-hotspot

# ── Backend (phase 2+) ────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
